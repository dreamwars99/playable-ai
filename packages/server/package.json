{
  "name": "@playable-ai/server",
  "version": "0.2.0",
  "description": "Server-side provider helpers for Playable AI workflows.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamwars99/playable-ai.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/dreamwars99/playable-ai/issues"
  },
  "homepage": "https://github.com/dreamwars99/playable-ai/tree/main/packages/server#readme",
  "keywords": [
    "ai",
    "node",
    "typescript",
    "openai-compatible",
    "provider-adapter"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "playable-ai": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
