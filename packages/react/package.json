{
  "name": "@playable-ai/react",
  "version": "0.1.1",
  "description": "React hooks for Playable AI task and candidate workflows.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamwars99/playable-ai.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/dreamwars99/playable-ai/issues"
  },
  "homepage": "https://github.com/dreamwars99/playable-ai/tree/main/packages/react#readme",
  "keywords": [
    "ai",
    "react",
    "typescript",
    "structured-output",
    "prompt-engineering"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "playable-ai": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "typescript": "^5.9.3"
  }
}
